  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "YOU DID IT!\r\n \r\nYou bought the last upgrade. That's it. That's the
    game... for now.\r\n \r\nThanks so much for playing all the way to the end. This
    is a small side project and I'm still tinkering away at it, so there's plenty\r\nmore
    chaos, and more questionable machinery to come.\n\nSorry if this screen is a
    bit disapointing ... also something I will keep working on, phew!\r\n \r\nIf
    you had fun, leaving a rating or a bit of feedback below means the world and
    helps me keep building. See you in the next update!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a9fb72713462bd34a99acbf23a40dd74, type: 2}
