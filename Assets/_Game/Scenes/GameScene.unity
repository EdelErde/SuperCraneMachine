  tabPrefab: {fileID: 4507924386111381229, guid: 09ab9a1a5d840754ab53033fdfed3b98, type: 3}
  tabBar: {fileID: 408397466}
  setupScript: '=== Page: Basics

    # Hands

    HandStrengthUpgrade

    DragCountUpgrade

    #
    Economy

    MoneyMultiplierUpgrade

    EggValueUpgrade > MoneyMultiplierUpgrade

    #
    Production

    FasterRainUpgrade > MoneyMultiplierUpgrade

    MoreItemsUpgrade
    > MoneyMultiplierUpgrade

    # Early items

    UnlockBananaUpgrade > DragCountUpgrade

    BananaValueUpgrade
    > UnlockBananaUpgrade

    UnlockTinCanUpgrade > UnlockBananaUpgrade

    ScrapValueUpgrade
    > UnlockTinCanUpgrade

    TinCanChanceUpgrade > UnlockTinCanUpgrade

    

    ===
    Page: Fuel & Blower > needs 8 upgrades

    # Resource intake

    UnlockResourceHoleUpgrade

    UnlockConverterUpgrade
    > UnlockResourceHoleUpgrade

    FuelPerEggUpgrade > UnlockConverterUpgrade

    FuelConvertRateUpgrade
    > UnlockConverterUpgrade

    # Leaf blower

    UnlockLeafBlowerUpgrade >
    UnlockConverterUpgrade

    BlowPowerUpgrade > UnlockLeafBlowerUpgrade

    BlowEfficiencyUpgrade
    > UnlockLeafBlowerUpgrade

    # Mid items

    UnlockTeddyUpgrade > UnlockLeafBlowerUpgrade

    TeddyValueUpgrade
    > UnlockTeddyUpgrade

    TeddyChanceUpgrade > UnlockTeddyUpgrade

    

    ===
    Page: Sorting & Belt > needs UnlockLeafBlowerUpgrade

    # Conveyor

    UnlockConveyorUpgrade

    ConveyorSpeedUpgrade
    > UnlockConveyorUpgrade

    ConveyorGripUpgrade > UnlockConveyorUpgrade

    #
    Sorting machine

    UnlockSortingMachineUpgrade > UnlockConveyorUpgrade

    SortEfficiencyUpgrade
    > UnlockSortingMachineUpgrade

    SortCapacityUpgrade > UnlockSortingMachineUpgrade

    #
    Endgame items

    UnlockDiamondUpgrade > UnlockConveyorUpgrade

    DiamondValueUpgrade
    > UnlockDiamondUpgrade

    DiamondChanceUpgrade > UnlockDiamondUpgrade

    LighterItemsUpgrade
    > UnlockDiamondUpgrade'
