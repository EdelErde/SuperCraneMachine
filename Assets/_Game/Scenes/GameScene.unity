  m_Script: {fileID: 11500000, guid: 56a0a385d69ac42468f5a450d951b2f4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CraneMachine.UpgradeView
  groupPrefab: {fileID: 8342445265293285066, guid: 22f9717b8dca9b14b979098ce17090b5, type: 3}
  buttonPrefab: {fileID: 3950457295023990925, guid: d176deb9992023e41adcb48b8a7162eb, type: 3}
  content: {fileID: 749912846}
  setupScript: '# Hands

    HandStrengthUpgrade

    DragCountUpgrade

    DragRadiusUpgrade
    > DragCountUpgrade



    # Economy

    MoneyMultiplierUpgrade

    EggValueUpgrade
    > MoneyMultiplierUpgrade

    BananaValueUpgrade > UnlockBananaUpgrade

    ScrapValueUpgrade
    > UnlockTinCanUpgrade

    TeddyValueUpgrade > UnlockTeddyUpgrade

    DiamondValueUpgrade
    > UnlockDiamondUpgrade



    # Items

    UnlockBananaUpgrade > DragCountUpgrade

    UnlockTinCanUpgrade
    > UnlockBananaUpgrade

    UnlockTeddyUpgrade > UnlockTinCanUpgrade

    UnlockDiamondUpgrade
    > UnlockConveyorUpgrade

    LighterItemsUpgrade > UnlockDiamondUpgrade


    #
    Item chance

    TinCanChanceUpgrade > UnlockTinCanUpgrade

    TeddyChanceUpgrade
    > UnlockTeddyUpgrade

    DiamondChanceUpgrade > UnlockDiamondUpgrade



    #
    Claw

    UnlockClawUpgrade > DragCountUpgrade:2

    ClawSpeedUpgrade > UnlockClawUpgrade

    ClawLiftSpeedUpgrade
    > UnlockClawUpgrade

    GrabStrengthUpgrade > UnlockClawUpgrade

    GrabCapacityUpgrade
    > UnlockClawUpgrade

    AutoClawUpgrade > ClawSpeedUpgrade:2

    AutoClawRateUpgrade
    > AutoClawUpgrade


    # Conveyor

    UnlockConveyorUpgrade > ClawSpeedUpgrade:3

    ConveyorSpeedUpgrade
    > UnlockConveyorUpgrade

    ConveyorGripUpgrade > UnlockConveyorUpgrade


    #
    Production

    FasterRainUpgrade > MoneyMultiplierUpgrade

    MoreItemsUpgrade
    > MoneyMultiplierUpgrade'
