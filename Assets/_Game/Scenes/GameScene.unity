  groupPrefab: {fileID: 8342445265293285066, guid: 22f9717b8dca9b14b979098ce17090b5, type: 3}
  buttonPrefab: {fileID: 3950457295023990925, guid: d176deb9992023e41adcb48b8a7162eb, type: 3}
  content: {fileID: 966045756}
  pagePrefab: {fileID: 4033835003400156166, guid: d13e8af87bf587e4a8dea4a4072f3fb1, type: 3}
  tabPrefab: {fileID: 4507924386111381229, guid: 09ab9a1a5d840754ab53033fdfed3b98, type: 3}
  tabBar: {fileID: 408397466}
  setupScript: '=== Page: Basics

    # Hands

    HandStrengthUpgrade

    DragCountUpgrade

    #
    Economy

    MoneyMultiplierUpgrade

    EggValueUpgrade > MoneyMultiplierUpgrade

    #
    Production

    FasterRainUpgrade > MoneyMultiplierUpgrade

    MoreItemsUpgrade
    > MoneyMultiplierUpgrade

    # Early items

    UnlockBananaUpgrade > DragCountUpgrade

    BananaValueUpgrade
    > UnlockBananaUpgrade

    UnlockTinCanUpgrade > UnlockBananaUpgrade

    ScrapValueUpgrade
    > UnlockTinCanUpgrade

    TinCanChanceUpgrade > UnlockTinCanUpgrade

    ===
    Page: Fuel & Blower > needs 8 upgrades

    # Resource intake

    UnlockResourceHoleUpgrade

    FuelPerEggUpgrade
    > UnlockResourceHoleUpgrade

    FuelConvertRateUpgrade > UnlockResourceHoleUpgrade

    #
    Leaf blower

    UnlockLeafBlowerUpgrade > UnlockResourceHoleUpgrade

    BlowPowerUpgrade
    > UnlockLeafBlowerUpgrade

    BlowEfficiencyUpgrade > UnlockLeafBlowerUpgrade

    #
    Mid items

    UnlockTeddyUpgrade > UnlockLeafBlowerUpgrade

    TeddyValueUpgrade
    > UnlockTeddyUpgrade

    TeddyChanceUpgrade > UnlockTeddyUpgrade

    === Page:
    Sorting & Belt > needs UnlockLeafBlowerUpgrade

    # Conveyor

    UnlockConveyorUpgrade

    ConveyorSpeedUpgrade
    > UnlockConveyorUpgrade

    ConveyorGripUpgrade > UnlockConveyorUpgrade

    #
    Sorting machine

    UnlockSortingMachineUpgrade > UnlockConveyorUpgrade

    SortEfficiencyUpgrade
    > UnlockSortingMachineUpgrade

    SortCapacityUpgrade > UnlockSortingMachineUpgrade

    #
    Endgame items

    UnlockDiamondUpgrade > UnlockConveyorUpgrade

    DiamondValueUpgrade
    > UnlockDiamondUpgrade

    DiamondChanceUpgrade > UnlockDiamondUpgrade

    LighterItemsUpgrade
    > UnlockDiamondUpgrade

    # The End

    FinalUpgrade > UnlockDiamondUpgrade'
